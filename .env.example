DATABASE_URL="postgresql://trendplan:trendplan@localhost:5432/trendplan"
# Neon/Vercel: keep DATABASE_URL as the pooled (-pooler) URL for the app.
# Set DIRECT_URL to the non-pooled connection for prisma migrate (avoids P1002).
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
AUTH_SECRET="generate-a-long-random-string"
# Canonical app URL (required in production for reset/verify email links).
# AUTH_URL="https://your-app.vercel.app"
# Trust Host / X-Forwarded-Host only when the platform or reverse proxy strips
# untrusted forwarded headers (Vercel sets VERCEL=1 so trustHost is on there).
# Local next-auth without AUTH_URL usually needs:
AUTH_TRUST_HOST="true"
# Self-hosted: set AUTH_URL and leave AUTH_TRUST_HOST unset/false unless your
# edge proxy overwrites X-Forwarded-Host.
# TRUST_PROXY_IP="true"  # only if reverse proxy overwrites X-Forwarded-For (rate limits)
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_…"  # Vercel Blob — foto profil Akun
# Web Push (Pengingat plan H-1 + kabar update aplikasi)
# Generate: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="B…"   # same value as VAPID_PUBLIC_KEY
# VAPID_PUBLIC_KEY="B…"
# VAPID_PRIVATE_KEY="…"
# VAPID_SUBJECT="mailto:you@example.com"
# CRON_SECRET="long-random-string"   # cron + /api/push/broadcast Bearer token
# Email (Resend) — OFF by default until a verified sending domain is ready.
# Do not use onboarding@resend.dev for multi-recipient production mail.
# After verifying a domain at https://resend.com/domains:
#   1) EMAIL_FROM="TrendPlan <noreply@yourdomain.com>"
#   2) RESEND_API_KEY="re_…"
#   3) TRANSACTIONAL_EMAIL_ENABLED="true"
#   4) NEXT_PUBLIC_TRANSACTIONAL_EMAIL_ENABLED="true"  # shows "Lupa password?" in UI
# TRANSACTIONAL_EMAIL_ENABLED="false"
# NEXT_PUBLIC_TRANSACTIONAL_EMAIL_ENABLED="false"
# EMAIL_FROM="TrendPlan <noreply@yourdomain.com>"
# RESEND_API_KEY="re_…"
# Opt-in email verification soft-gate (requires transactional email too):
# EMAIL_VERIFICATION_REQUIRED="true"

# AI caption/hashtag assist on planner detail (“Bantu AI”).
# Off by default — without these, the button still fills template saran.
# AI_ASSIST_ENABLED="true"
# GROQ_API_KEY="gsk_…"
# Optional override — must support Groq json_schema (default openai/gpt-oss-20b).
# Allowed: openai/gpt-oss-20b | openai/gpt-oss-120b | openai/gpt-oss-safeguard-20b
# GROQ_MODEL="openai/gpt-oss-20b"
