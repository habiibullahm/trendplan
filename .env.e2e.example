# Optional Playwright auth (copy to .env.e2e — gitignored).
# Needs an onboarded user that lands on /dashboard after login.
# E2E_EMAIL="creator@example.com"
# E2E_PASSWORD="your-local-test-password"
#
# Second onboarded user for partner week-share accept journey.
# E2E_PARTNER_EMAIL="partner@example.com"
# E2E_PARTNER_PASSWORD="your-local-partner-password"
#
# Auth setup writes `.auth/user.json` and `.auth/partner.json` (gitignored).
