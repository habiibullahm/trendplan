// TrendPlan — Prisma schema (PostgreSQL for Vercel/Neon)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentFormat {
  POV
  LIST
  STORYTELLING
}

enum ContentStatus {
  IDE
  DRAFT
  READY
  POSTED
}

model User {
  id                    String      @id @default(cuid())
  email                 String      @unique
  passwordHash          String
  name                  String?
  imageUrl              String?
  niche                 String      @default("Couple Date Ideas")
  weeklyGoal            Int         @default(3)
  onboardingComplete    Boolean     @default(false)
  /** True when password does not meet current passwordSchema (legacy accounts). */
  passwordNeedsUpgrade  Boolean     @default(true)
  /** Null until email verification succeeds (or skipped in local dev). */
  emailVerified         DateTime?
  /** Bumped on password change/reset so old JWTs are rejected. */
  passwordVersion       Int         @default(0)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  weekPlans             WeekPlan[]
  weekPlanMemberships   WeekPlanMember[]
  authTokens            AuthToken[]
  pushSubscriptions     PushSubscription[]
  reminderDispatches    ReminderDispatch[]
  feedbacks             Feedback[]
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFY
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId, type])
}

model Trend {
  id           String          @id @default(cuid())
  title        String
  hook         String
  format       ContentFormat
  score        Int
  reason       String
  niche        String          @default("Couple Date Ideas")
  /** Curated cover poster (public URL, e.g. /media/trends/covers/…). */
  coverUrl     String?
  createdAt    DateTime        @default(now())
  contentItems ContentItem[]
}

model WeekPlan {
  id         String           @id @default(cuid())
  userId     String
  weekStart  DateTime
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      ContentItem[]
  activities Activity[]
  members    WeekPlanMember[]
  invites    WeekPlanInvite[]

  @@unique([userId, weekStart])
  @@index([userId])
}

/** Partner seat on a week plan (owner stays WeekPlan.userId). At most one partner. */
model WeekPlanMember {
  id         String   @id @default(cuid())
  weekPlanId String   @unique
  userId     String
  createdAt  DateTime @default(now())
  weekPlan   WeekPlan @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/** Invite link/email token for partner week share (7d TTL). */
model WeekPlanInvite {
  id              String    @id @default(cuid())
  weekPlanId      String
  createdByUserId String
  tokenHash       String    @unique
  invitedEmail    String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  weekPlan        WeekPlan  @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)

  @@index([weekPlanId])
}

/** Daily life / date activities — many per day; not content. */
model Activity {
  id         String   @id @default(cuid())
  weekPlanId String
  dayOfWeek  Int
  title      String
  done       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  weekPlan   WeekPlan @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)

  @@index([weekPlanId, dayOfWeek])
}

model ContentItem {
  id              String        @id @default(cuid())
  weekPlanId      String
  dayOfWeek       Int
  title           String
  hook            String?
  caption         String?
  hashtags        String?
  status          ContentStatus @default(IDE)
  trendId         String?
  performanceNote String?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  weekPlan        WeekPlan      @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)
  trend           Trend?        @relation(fields: [trendId], references: [id], onDelete: SetNull)

  @@unique([weekPlanId, dayOfWeek])
  @@index([weekPlanId])
  @@index([status])
  @@index([deletedAt])
}

/** Shared auth abuse buckets (works across serverless instances). */
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/** Browser Web Push subscription (Pengingat plan + app updates). */
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/** Idempotency for daily H-1 plan reminder sends (targetDate = Jakarta Y-M-D of besok). */
model ReminderDispatch {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetDate String
  createdAt  DateTime @default(now())

  @@unique([userId, targetDate])
  @@index([userId])
}

/** In-app user feedback from Akun (Kirim masukan). */
model Feedback {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        String
  message         String
  createdAt       DateTime  @default(now())
  /** Admin reply text; null until first reply. */
  adminReply      String?
  repliedAt       DateTime?
  repliedByEmail  String?

  @@index([userId])
  @@index([createdAt])
}
