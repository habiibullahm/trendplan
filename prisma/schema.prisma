// TrendPlan — Prisma schema (PostgreSQL for Vercel/Neon)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentFormat {
  POV
  LIST
  STORYTELLING
}

enum ContentStatus {
  IDE
  DRAFT
  READY
  POSTED
}

model User {
  id                    String      @id @default(cuid())
  email                 String      @unique
  passwordHash          String
  name                  String?
  imageUrl              String?
  niche                 String      @default("Couple Date Ideas")
  weeklyGoal            Int         @default(3)
  onboardingComplete    Boolean     @default(false)
  /** True when password does not meet current passwordSchema (legacy accounts). */
  passwordNeedsUpgrade  Boolean     @default(true)
  /** Null until email verification succeeds (or skipped in local dev). */
  emailVerified         DateTime?
  /** Bumped on password change/reset so old JWTs are rejected. */
  passwordVersion       Int         @default(0)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  weekPlans             WeekPlan[]
  authTokens            AuthToken[]
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFY
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId, type])
}

model Trend {
  id           String          @id @default(cuid())
  title        String
  hook         String
  format       ContentFormat
  score        Int
  reason       String
  niche        String          @default("Couple Date Ideas")
  /** Mock TikTok-style cover poster (public URL). */
  coverUrl     String?
  /** Optional short mock video clip. */
  videoUrl     String?
  /** Display label for trending sound. */
  audioTitle   String?
  /** Optional mock audio clip. */
  audioUrl     String?
  createdAt    DateTime        @default(now())
  contentItems ContentItem[]
}

model WeekPlan {
  id        String        @id @default(cuid())
  userId    String
  weekStart DateTime
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ContentItem[]

  @@unique([userId, weekStart])
  @@index([userId])
}

model ContentItem {
  id              String        @id @default(cuid())
  weekPlanId      String
  dayOfWeek       Int
  title           String
  hook            String?
  caption         String?
  hashtags        String?
  status          ContentStatus @default(IDE)
  trendId         String?
  performanceNote String?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  weekPlan        WeekPlan      @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)
  trend           Trend?        @relation(fields: [trendId], references: [id], onDelete: SetNull)

  @@unique([weekPlanId, dayOfWeek])
  @@index([weekPlanId])
  @@index([status])
  @@index([deletedAt])
}

/** Shared auth abuse buckets (works across serverless instances). */
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}
